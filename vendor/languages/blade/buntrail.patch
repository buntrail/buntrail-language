 static bool scan(Scanner *scanner, TSLexer *lexer, const bool *valid_symbols) {
+    if (valid_symbols[VERBATIM_CONTENT]) {
+        bool content = false;
+        while (!lexer->eof(lexer)) {
+            lexer->mark_end(lexer);
+            if (lexer->lookahead == '@') {
+                const char *end = "@endverbatim";
+                while (*end && lexer->lookahead == *end) { advance(lexer); end++; }
+                if (!*end) { lexer->result_symbol = VERBATIM_CONTENT; return content; }
+            } else { advance(lexer); }
+            content = true;
+        }
+        lexer->mark_end(lexer);
+        lexer->result_symbol = VERBATIM_CONTENT;
+        return content;
